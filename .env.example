# Скопируйте в .env (он в .gitignore) и заполните. docker compose подхватывает .env автоматически.
# На стенде файл лежит в ~/starlift/env/backend.env, workflow деплоя копирует его в .env.

# GigaChat для продюсера и парсинга. Ключ авторизации тот же, что GIGACHAT_TOKEN у weak-signals
GIGACHAT_TOKEN=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max

# Поиск для парсинга конференций (serper.dev)
PARSING_SEARCH_API_KEY=

# Сервис оценки спикеров по слабым сигналам (репозиторий startlift-weak-signals).
# В docker compose он в сети java-speaker-net под именем signals; для запуска без docker — http://localhost:8000
WEAK_SIGNALS_BASE_URL=http://signals:8000

# Секрет для JWT (HS256), не короче 32 символов
JWT_SECRET=

# demo — залить демо-спикеров продюсера (0017_producer_demo_seed.yaml).
# Только для локального демо: пароль демо-пользователей — demo-b2549f435fbf.
APP_LIQUIBASE_CONTEXTS=demo
