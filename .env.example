# Скопируйте в .env (он в .gitignore) и заполните. docker compose подхватывает .env автоматически.

# LLM для продюсера и парсинга (OpenAI-совместимый API)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# Поиск для парсинга конференций (serper.dev)
PARSING_SEARCH_API_KEY=

# Секрет для JWT (HS256), не короче 32 символов
JWT_SECRET=

# demo — залить демо-спикеров продюсера (0017_producer_demo_seed.yaml).
# Только для локального демо: пароль демо-пользователей лежит в http/http-client.env.json.
APP_LIQUIBASE_CONTEXTS=demo
